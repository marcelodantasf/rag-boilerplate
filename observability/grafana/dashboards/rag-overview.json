      "id": 2,
      "targets": [{"expr": "sum by (service_name) (rate(rag_core_http_requests_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum by (service_name) (rate(rag_core_http_requests_total[5m])), 0.001)", "legendFormat": "{{service_name}}", "refId": "A"}],
