# Docker Compose project settings
COMPOSE_PROJECT_NAME=rag-boilerplate

# RAG Core API
RAG_CORE_PORT=8000
EMBEDDING_BASE_URL=http://embedding-api:8001
VECTOR_DB_URL=http://qdrant:6333

# Embedding API
EMBEDDING_API_PORT=8001
# Public API model name, immutable source revision, and expected vector contract.
DEFAULT_MODEL_ID=all-MiniLM-L6-v2
MODEL_SOURCE=sentence-transformers/all-MiniLM-L6-v2
MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
EXPECTED_DIMENSION=384
INFERENCE_DEVICE=cpu
NORMALIZE_EMBEDDINGS=true

# Admission limits and inference batching.
ENGINE_BATCH_SIZE=32
MAX_BATCH_ITEMS=64
MAX_INPUT_BYTES=65536
MAX_TOTAL_INPUT_BYTES=262144
MAX_BATCH_TOKENS=8192

# Structured request log threshold. Raw text and vectors are never logged.
LOG_LEVEL=INFO

# Vector database
QDRANT_PORT=6333
