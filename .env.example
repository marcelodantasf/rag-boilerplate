# Docker Compose project settings
COMPOSE_PROJECT_NAME=rag-boilerplate

# RAG Core API
RAG_CORE_PORT=8000
EMBEDDING_BASE_URL=http://embedding-api:8001
EMBEDDING_TIMEOUT_MS=10000
VECTOR_DB_URL=http://qdrant:6333
# Leave empty for unsecured local Qdrant only; inject through a secret manager outside development.
VECTOR_DB_API_KEY=
DISTANCE_METRIC=cosine
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
MAX_DOCUMENT_BYTES=262144
MAX_CHUNKS_PER_DOCUMENT=512
MAX_EMBEDDING_BATCH_ITEMS=64
MAX_SEARCH_TOP_K=100
MAX_QUERY_BYTES=16384
MAX_METADATA_FIELDS=32
MAX_METADATA_VALUE_BYTES=1024

# Embedding API
EMBEDDING_API_PORT=8001
# Public API model name, immutable source revision, and expected vector contract.
DEFAULT_MODEL_ID=all-MiniLM-L6-v2
MODEL_SOURCE=sentence-transformers/all-MiniLM-L6-v2
MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
EXPECTED_DIMENSION=384
INFERENCE_DEVICE=cpu
NORMALIZE_EMBEDDINGS=true

# Admission limits and inference batching.
ENGINE_BATCH_SIZE=32
MAX_BATCH_ITEMS=64
MAX_INPUT_BYTES=65536
MAX_TOTAL_INPUT_BYTES=262144
MAX_BATCH_TOKENS=8192

# Structured request log threshold. Raw text and vectors are never logged.
LOG_LEVEL=INFO

# Vector database
QDRANT_PORT=6333

# Optional observability profile. Start it with:
# docker compose --profile application --profile observability up --build
DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Local-only default. Override with a secret before any shared deployment.
GRAFANA_ADMIN_PASSWORD=admin
